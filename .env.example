# App
APP_URL=http://127.0.0.1:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=authjs.session-token

# Database
DATABASE_URL=mysql://twc:twc_dev_password@127.0.0.1:3306/twc

# Seed. Required for `npm run db:seed`; seed refuses to run in production.
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeThisSeedPassword123

# Payment
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Telegram
TELEGRAM_MODE=redirect
TELEGRAM_FREE_CHANNEL_URL=https://t.me/twc_free_demo
TELEGRAM_PREMIUM_CHANNEL_LABEL=TWC Premium Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PRIVATE_CHANNEL_ID=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TWC <noreply@example.com>

# Jobs
CRON_SECRET=replace-with-cron-secret
